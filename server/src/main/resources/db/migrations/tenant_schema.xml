<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_tenants_table" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tenants"/>
            </not>
        </preConditions>
        <createTable tableName="tenants">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tenant" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints unique="true" uniqueConstraintName="uk_tenant" nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(150)">
                <constraints unique="true" uniqueConstraintName="uk_tenant_slug" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="institution_type" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <!--
        "Tenant zero" — the single institution this app already serves. Every pre-existing row in
        every other table gets backfilled onto this tenant (see tenant_scoping.xml), and it's also
        the fallback tenant for any request that doesn't send an X-Tenant-Slug header, so the
        existing single-tenant client and every existing test keep working unmodified.
    -->
    <changeSet id="seed_default_tenant" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM tenants WHERE slug = 'default'</sqlCheck>
        </preConditions>
        <insert tableName="tenants">
            <column name="code" value="TNT0001"/>
            <column name="slug" value="default"/>
            <column name="name" value="Bowen University"/>
            <column name="institution_type" value="TERTIARY"/>
            <column name="status" value="ACTIVATED"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

</databaseChangeLog>
