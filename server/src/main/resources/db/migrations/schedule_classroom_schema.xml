<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_schedule_classrooms_table" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="schedule_classrooms"/>
            </not>
        </preConditions>
        <createTable tableName="schedule_classrooms">
            <column name="schedule_id" type="BIGINT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_schedule_classroom_on_schedule"
                        referencedTableName="schedules"
                        referencedColumnNames="id"
                />
            </column>
            <column name="classroom_id" type="BIGINT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_schedule_classroom_on_classroom"
                        referencedTableName="classrooms"
                        referencedColumnNames="id"
                />
            </column>
        </createTable>
        <addPrimaryKey tableName="schedule_classrooms" columnNames="schedule_id, classroom_id" constraintName="pk_schedule_classroom"/>
    </changeSet>

</databaseChangeLog>