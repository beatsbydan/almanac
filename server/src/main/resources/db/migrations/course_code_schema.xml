<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_course_codes_table" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="course_codes"/>
            </not>
        </preConditions>
        <createTable tableName="course_codes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_course" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints unique="true" uniqueConstraintName="uk_course" nullable="false"/>
            </column>
            <column name="course_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="course_id" type="BIGINT">
                <constraints
                        nullable="false"
                        referencedColumnNames="id"
                        referencedTableName="courses"
                        foreignKeyName="fk_course_code_on_course"
                />
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>