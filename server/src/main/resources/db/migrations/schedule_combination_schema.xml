<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_schedule_combinations_table" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="schedule_combinations"/>
            </not>
        </preConditions>
        <createTable tableName="schedule_combinations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_schedule_combination" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints unique="true" uniqueConstraintName="uk_schedule_combination" nullable="false"/>
            </column>
            <column name="combination" type="MEDIUMTEXT">
                <constraints nullable="false"/>
            </column>
            <column name="day" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="classroom_name" type="MEDIUMTEXT">
                <constraints nullable="false"/>
            </column>
            <column name="schedule_id" type="BIGINT">
                <constraints
                        nullable="false"
                        referencedColumnNames="id"
                        referencedTableName="schedules"
                        foreignKeyName="fk_schedule_combination_on_schedule"
                />
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>