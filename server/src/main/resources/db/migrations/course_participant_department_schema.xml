<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_course_participant_departments_table" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="course_participant_departments"/>
            </not>
        </preConditions>
        <createTable tableName="course_participant_departments">
            <column name="course_participant_id" type="BIGINT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_course_participant_department_on_schedule"
                        referencedTableName="course_participants"
                        referencedColumnNames="id"
                />
            </column>
            <column name="department_id" type="BIGINT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_course_participant_department_on_department"
                        referencedTableName="departments"
                        referencedColumnNames="id"
                />
            </column>
        </createTable>
        <addPrimaryKey tableName="course_participant_departments" columnNames="course_participant_id, department_id" constraintName="pk_course_participant_department"/>
    </changeSet>

</databaseChangeLog>