<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_timetables_table" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="timetables"/>
            </not>
        </preConditions>
        <createTable tableName="timetables">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_timetable" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints unique="true" uniqueConstraintName="uk_timetable" nullable="false"/>
            </column>
            <column name="file_name" type="MEDIUMTEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="generation_tracker_id" type="BIGINT">
                <constraints
                    foreignKeyName="fk_timetable_on_generation_tracker"
                    referencedTableName="generation_trackers"
                    referencedColumnNames="id"
                />
            </column>
            <column name="creation_status" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="semester" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="session" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="creation_start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="creation_end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>