<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_user_courses_table" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_courses"/>
            </not>
        </preConditions>
        <createTable tableName="user_courses">
            <column name="user_id" type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_user_course_on_user"
                    referencedTableName="users"
                    referencedColumnNames="id"
                />
            </column>
            <column name="course_id" type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_user_course_on_course"
                    referencedTableName="courses"
                    referencedColumnNames="id"
                />
            </column>
        </createTable>
        <addPrimaryKey tableName="user_courses" columnNames="user_id, course_id" constraintName="pk_user_course"/>
    </changeSet>

</databaseChangeLog>