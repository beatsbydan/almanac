<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Adds tenant_id to every table owned by TenantOwnedModel entities. Deliberately NOT folded
        into the original createTable changesets for these tables — those already ran (and are
        guarded by "if table doesn't exist" preconditions) against any database that predates this
        change, so editing them wouldn't actually add the column anywhere it's needed. Each table
        gets: a nullable column, a backfill onto the default tenant (so pre-existing rows don't
        become orphaned), then NOT NULL + the FK, in that order because the column has to be
        populated before either constraint can be added.
    -->

    <changeSet id="add_tenant_id_to_colleges" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="colleges" columnName="tenant_id"/></not>
        </preConditions>
        <addColumn tableName="colleges">
            <column name="tenant_id" type="BIGINT"/>
        </addColumn>
        <sql>UPDATE colleges SET tenant_id = (SELECT id FROM tenants WHERE slug = 'default') WHERE tenant_id IS NULL;</sql>
        <addNotNullConstraint tableName="colleges" columnName="tenant_id" columnDataType="BIGINT"/>
        <addForeignKeyConstraint baseTableName="colleges" baseColumnNames="tenant_id" constraintName="fk_college_on_tenant" referencedTableName="tenants" referencedColumnNames="id"/>
    </changeSet>

