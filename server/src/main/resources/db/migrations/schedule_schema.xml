<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_schedules_table" author="daniel.onyeachonam" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="schedules"/>
            </not>
        </preConditions>
        <createTable tableName="schedules">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_schedule" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints unique="true" uniqueConstraintName="uk_schedule" nullable="false"/>
            </column>
            <column name="start_time" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="day" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="time_period" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints
                    nullable="false"
                    referencedColumnNames="id"
                    referencedTableName="users"
                    foreignKeyName="fk_schedule_on_user"
                />
            </column>
            <column name="course_id" type="BIGINT">
                <constraints
                    nullable="false"
                    referencedColumnNames="id"
                    referencedTableName="courses"
                    foreignKeyName="fk_schedule_on_course"
                />
            </column>
            <column name="timetable_id" type="BIGINT">
                <constraints
                    nullable="false"
                    referencedColumnNames="id"
                    referencedTableName="timetables"
                    foreignKeyName="fk_schedule_on_timetable"
                />
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>